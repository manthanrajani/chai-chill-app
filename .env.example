# PostgreSQL connection string (local, Neon, Supabase, Railway...)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chai_chill?schema=public"
# Secret used to sign staff login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Used only by `npm run db:seed` to create the first admin login
SEED_ADMIN_EMAIL="owner@chaichill.cafe"
SEED_ADMIN_PASSWORD="ChangeMe@123"
